# Settings for `docker compose`. Copy to .env and fill in; .env is not committed.

# Signs sessions (players' seat tokens). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Password for the compose PostgreSQL server. Changing it later needs the
# password changed inside the database too (the volume keeps the old one).
POSTGRES_PASSWORD=

# Host names the site answers to, comma separated, e.g. chaos.example.com
DJANGO_ALLOWED_HOSTS=*

# Behind an HTTPS reverse proxy, the site's public origin(s), comma separated,
# e.g. https://chaos.example.com (needed for logins and forms to pass CSRF).
DJANGO_CSRF_TRUSTED_ORIGINS=

# Where the Django admin is: a path that is hard to guess, e.g. manage-x7q2k.
# Empty: the site has no admin.
DJANGO_ADMIN_PATH=

# The site image to run. On a server, the name it was loaded or pushed under,
# e.g. registry.example.com/chaos-online:latest
CHAOS_IMAGE=chaos-online:latest

# Where the site listens on the host. The default keeps it local, for a
# reverse proxy on the same machine; use 0.0.0.0 to expose it directly.
CHAOS_BIND=127.0.0.1
CHAOS_PORT=8000
